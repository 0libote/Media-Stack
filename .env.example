# setup.py writes .env for your machine. This file is a reference.
COMPOSE_FILE=compose.yaml
PUID=1000
PGID=1000
TZ=Etc/UTC
DATA_DIR=./data
# Use your server's LAN IPv4 address for access from other devices.
BIND_ADDRESS=127.0.0.1
DOWNLOADS_ENABLED=false
VPN_ENABLED=false
# With the recovery timer, set direct to continue normal downloads after stopping Gluetun.
VPN_STOP_ACTION=pause
# Only for a trusted HTTPS reverse proxy; see docs/maintenance.md.
PANEL_COOKIE_SECURE=0
PANEL_TRUST_PROXY=0
# Optional compose.gpu.yaml: use stat -c %g /dev/dri/renderD128 on the host.
# JELLYFIN_RENDER_GID=109
# For VPN downloads after installing secrets/wg0.conf:
# Normal downloads: COMPOSE_FILE=compose.yaml:compose.downloads.direct.yaml
# VPN downloads: COMPOSE_FILE=compose.yaml:compose.downloads.direct.yaml:compose.vpn.yaml
