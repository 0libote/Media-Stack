# setup.py writes .env for your machine. This file is a reference.
COMPOSE_FILE=compose.yaml
PUID=1000
PGID=1000
TZ=Etc/UTC
DATA_DIR=./data
# Use your server's LAN IPv4 address for access from other devices.
BIND_ADDRESS=127.0.0.1
DOWNLOADS_ENABLED=false
# Only for a trusted HTTPS reverse proxy; see docs/maintenance.md.
PANEL_COOKIE_SECURE=0
PANEL_TRUST_PROXY=0
# For VPN downloads after installing secrets/wg0.conf:
# COMPOSE_FILE=compose.yaml:compose.downloads.yaml
